# Dependencies and generated application output
app/node_modules/
app/build/
app/.adonisjs/
# The browser Tuyau client imports this registry during a production build.
# Keep the small checked-in fallback so a fresh clone can build before Ace
# regenerates the rest of .adonisjs.
!app/.adonisjs/
!app/.adonisjs/client/
!app/.adonisjs/client/registry/
!app/.adonisjs/client/registry/index.ts
!app/.adonisjs/client/registry/schema.d.ts
!app/.adonisjs/client/registry/tree.d.ts
app/.vite/

# Local environment and secrets
.env
.env.*
!.env.example
app/.env
app/.env.*
!app/.env.example

# Runtime files
app/tmp/
app/storage/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Test and browser artifacts
coverage/
playwright-report/
test-results/
/tmp/
*.png
*.jpg
# Bundled website photography is source, not a browser-test artifact.
!app/inertia/assets/*.jpg

# Local database/import artifacts
database/*.sqlite
database/*.sqlite3
database/*.db
postgres_data/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.pyc
__pycache__/

# Generated analytical exports
reports/**/.data-app-offline/
/reports/
